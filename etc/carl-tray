#!/usr/bin/env python3
"""Carl in the top bar.

The army has been invisible. It was down for twenty one hours in August and nothing said so,
because knowing meant remembering to run a command. A thing in the top bar is the difference
between state you can check and state you notice.

Deliberately small. It shows how many agents are up and whether any need attention, opens the
panel, and asks Carl about the screen when JJ asks it to. It decides nothing, stores nothing and
starts no agents: every action here shells out to `carl`, which is the one thing that owns the
army. A tray that kept its own idea of the state would be a second source of truth in the place
least able to defend one.

The screen is read on demand and never watched. JJ chose that on 2026 08 30. Nothing here takes
a picture unless a menu item was clicked, and `carl look` replaces the same file each time
rather than keeping a history. Ambient watching would make everything on screen readable by ten
agents, which is a decision to make deliberately rather than inherit from a convenience.

Python rather than Rust because the whole thing is a menu and a timer, and the GTK bindings are
already on the machine. It reads `carl army status --brief`, which exists as a stable contract
for exactly this: the tree output is laid out for a person and free to change.
"""

import subprocess
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import GLib, Gtk  # noqa: E402

# How often to ask. Five seconds is the supervisor's own tick, so anything faster reports the
# same answer twice and anything much slower means the top bar is stale when you look at it.
EVERY_SECONDS = 5

# Named icons, so this follows the desktop theme rather than shipping art that will not match.
ICON_OK = "emblem-default"
ICON_ATTENTION = "dialog-warning"
ICON_UNKNOWN = "dialog-question"


def carl(*args, timeout=10):
    """Runs carl and gives back its output, or None when it could not be asked.

    None is not zero. An army nobody could ask about is a different thing from an army with
    nothing running, and the top bar has to be able to say so.
    """
    try:
        done = subprocess.run(
            ["carl", *args], capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def read_state():
    """`running=10 asleep=0 attention=0 total=10` as a dict, or None."""
    line = carl("army", "status", "--brief")
    if not line:
        return None
    out = {}
    for pair in line.split():
        key, _, value = pair.partition("=")
        if value.isdigit():
            out[key] = int(value)
    return out or None


class Tray:
    def __init__(self):
        self.indicator = AppIndicator.Indicator.new(
            "carl-army", ICON_UNKNOWN, AppIndicator.IndicatorCategory.SYSTEM_SERVICES
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.status_item = Gtk.MenuItem(label="asking...")
        self.status_item.set_sensitive(False)
        self.indicator.set_menu(self.menu())
        self.refresh()
        GLib.timeout_add_seconds(EVERY_SECONDS, self.refresh)

    def menu(self):
        menu = Gtk.Menu()
        menu.append(self.status_item)
        menu.append(Gtk.SeparatorMenuItem())

        for label, handler in [
            ("Ask Carl about my screen", self.ask_screen),
            ("Ask Carl about this window", self.ask_window),
            ("Open the panel", self.open_panel),
            ("Status in a terminal", self.open_status),
            ("Revive whoever was given up on", self.revive),
        ]:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", handler)
            menu.append(item)

        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit this indicator")
        # Quits the icon and nothing else. The army and the panel are systemd's, and a tray that
        # could stop them would make closing a menu a way to take the machine down.
        quit_item.connect("activate", lambda _: Gtk.main_quit())
        menu.append(quit_item)

        menu.show_all()
        return menu

    def refresh(self):
        state = read_state()
        if state is None:
            self.indicator.set_icon_full(ICON_UNKNOWN, "Carl, cannot be asked")
            self.status_item.set_label("cannot reach carl")
            self.indicator.set_label("carl ?", "carl")
            return True

        running = state.get("running", 0)
        total = state.get("total", 0)
        attention = state.get("attention", 0)
        asleep = state.get("asleep", 0)

        parts = [f"{running} of {total} running"]
        if asleep:
            parts.append(f"{asleep} asleep")
        if attention:
            parts.append(f"{attention} need attention")
        self.status_item.set_label(", ".join(parts))

        # The label is what is actually visible without opening anything, so it carries the one
        # number worth interrupting somebody about rather than the reassuring one.
        if attention:
            self.indicator.set_icon_full(ICON_ATTENTION, "Carl, agents need attention")
            self.indicator.set_label(f"carl !{attention}", "carl")
        else:
            self.indicator.set_icon_full(ICON_OK, "Carl, healthy")
            self.indicator.set_label(f"carl {running}/{total}", "carl")
        return True

    def ask_screen(self, _):
        self.ask_about_screen(window_only=False)

    def ask_window(self, _):
        self.ask_about_screen(window_only=True)

    def ask_about_screen(self, window_only):
        """Takes one screenshot, on purpose, because JJ asked and not before.

        On demand rather than ambient, which JJ chose on 2026 08 30. Nothing here watches the
        screen and nothing keeps a picture: `carl look` replaces the same file each time. The
        difference matters, because ambient would make everything on screen readable by ten
        agents and that is a decision worth making deliberately rather than inheriting from a
        convenience.
        """
        what = self.prompt(
            "Ask about this window" if window_only else "Ask about the screen",
            "What should Carl look for?",
        )
        if what is None:
            return

        args = ["look"] + (["--window"] if window_only else []) + ([what] if what else [])
        # Off the main loop. Carl takes seconds and a frozen top bar for the whole of it looks
        # like the machine has hung rather than like something is being read.
        self.status_item.set_label("looking at the screen...")
        threading.Thread(target=self._look, args=(args,), daemon=True).start()

    def _look(self, args):
        answer = carl(*args, timeout=180)
        GLib.idle_add(self.show_answer, answer)

    def show_answer(self, answer):
        self.refresh()
        text = answer or "Carl could not answer. Check `carl look` in a terminal."
        dialog = Gtk.MessageDialog(
            transient_for=None,
            modal=False,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CLOSE,
            text="Carl looked at the screen",
        )
        dialog.format_secondary_text(text)
        # Scrollable, because an answer about a screenshot is a paragraph rather than a line and
        # a dialog that grows off the display cannot be dismissed.
        dialog.set_default_size(560, -1)
        dialog.connect("response", lambda d, _: d.destroy())
        dialog.show()
        return False

    def prompt(self, title, question):
        """One line of text, or None when it was cancelled."""
        dialog = Gtk.Dialog(title=title, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Ask", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)

        entry = Gtk.Entry()
        entry.set_placeholder_text(question)
        entry.set_activates_default(True)
        entry.set_width_chars(48)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)
        box.add(Gtk.Label(label=question, xalign=0))
        box.add(entry)
        dialog.show_all()

        answered = dialog.run()
        text = entry.get_text().strip()
        dialog.destroy()
        return text if answered == Gtk.ResponseType.OK else None

    def open_panel(self, _):
        # Through systemd, because it owns the panel. Starting a second window by hand is how a
        # stale one ended up on screen next to a fresh binary.
        subprocess.Popen(["systemctl", "--user", "restart", "carl-panel.service"])

    def open_status(self, _):
        subprocess.Popen(
            ["gnome-terminal", "--", "bash", "-lc", "carl army status; read -n1 -r -p ''"]
        )

    def revive(self, _):
        subprocess.Popen(
            [
                "gnome-terminal",
                "--",
                "bash",
                "-lc",
                "carl army revive --fresh; read -n1 -r -p ''",
            ]
        )


if __name__ == "__main__":
    Tray()
    Gtk.main()
