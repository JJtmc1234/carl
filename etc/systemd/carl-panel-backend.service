[Unit]
# The Command Panel's backend, which owns the socket every panel talks to.
#
# Separate from the window on purpose. The backend is the thing with state: it holds the
# journal, answers the permission hook, and streams Carl's turns. The window is a view and is
# expected to be closed, reopened and rebuilt without the backend noticing.
#
# PartOf the graphical session because the window it serves lives there. Not Requires: a backend
# with no window is useful, since the permission hook and any panel_says client still reach it.
Description=Carl Command Panel, backend
PartOf=graphical-session.target

StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/carl panel
Restart=always
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
